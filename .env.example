# ── API ──
DATABASE_URL=postgresql://windward:windward@localhost:5432/windward_crm
SESSION_SECRET=change-me-to-random-string
PORT=3001
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=contact@windwardfinancial.net
SCHEDULING_LINK=https://windward.financial/schedule-an-appointment
QUO_API_KEY=your-quo-api-key-here
QUO_WEBHOOK_BASE_URL=https://your-api-domain.com
# Instant welcome text on new registrations (services/welcome-text.ts).
# Sent from the assigned rep's Quo line; falls back to this line, then the first synced line.
QUO_DEFAULT_FROM_NUMBER_ID=
# Public base URL of this API. Used to build the rep photo-card link in the
# welcome text (API_PUBLIC_URL/r/<slug>). Falls back to QUO_WEBHOOK_BASE_URL.
API_PUBLIC_URL=https://api.windward.financial
# Hard kill switch. Normal on/off, reps, and wording are in Admin CRM > Welcome Text.
WELCOME_SMS_ENABLED=true
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# CORS
PUBLIC_URL=http://localhost:80
ADMIN_URL=http://localhost:8080

# Webhook the API hits after admin creates/updates/deletes an event,
# so the static public site can be re-built. Leave blank to disable.
REBUILD_WEBHOOK_URL=

# ── Astro public site (build-time) ──
# Base URL of the API the public site posts forms to. Leave blank in
# docker-compose; nginx proxies /api/* to the api service.
PUBLIC_API_URL=
PUBLIC_SITE_URL=https://windward.financial
PUBLIC_NLG_LOGIN_URL=https://nlg-prod.auth0.com/login?audience=https%3A%2F%2Fnlgcpnprdaigw01.azure-api.net%2Fapi&client=PaETxB2EF0hn6xAsyv7g71KarNUJoQvz&connection=NLGCustomerDB&redirect_uri=https%3A%2F%2Fwww.nationallife.com%2Fcustomer%2Fauth%2Flogincallback&response_mode=form_post&response_type=code%20id_token&scope=openid%20profile%20email

# Read-only Postgres role used by the Astro build to query upcoming events.
# Unset to skip the events query (useful in CI previews without DB access).
BUILD_DATABASE_URL=
